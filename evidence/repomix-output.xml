<file path="frontend/src/App.css">
#root { min-height: 100vh; }

.app-shell { min-height: 100vh; }

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 248px;
  padding: 28px 18px;
  background: #111b32;
  color: #fff;
  display: flex;
  flex-direction: column;
  z-index: 2;
}

.brand { display: flex; align-items: center; gap: 12px; padding: 0 8px 42px; }
.brand-mark {
  width: 42px; height: 42px; border-radius: 13px;
  display: grid; place-items: center; background: #6c63e9;
  font-size: 21px; font-weight: 800;
}
.brand strong, .brand span, .sidebar-bottom strong, .sidebar-bottom span {
  display: block;
}
.brand strong { font-size: 15px; letter-spacing: .5px; }
.brand span { color: #a7b2c9; font-size: 11px; margin-top: 4px; }
.side-label, .metric-label, .section-kicker, .form-field label,
.scenario-area label, .eyebrow {
  font-size: 10px; font-weight: 750; letter-spacing: 1.1px;
}
.side-label { color: #75829e; padding: 0 12px 13px; }
.nav-item {
  color: #aab5ca; padding: 13px 12px; border-radius: 9px;
  font-size: 13px; margin-bottom: 5px;
}
.nav-item span { display: inline-block; width: 27px; font-size: 16px; }
.nav-item.active { color: #fff; background: #293653; }
.sidebar-bottom {
  margin-top: auto; padding: 16px 9px; border-top: 1px solid #293653;
  display: flex; align-items: center; gap: 10px;
}
.sidebar-bottom strong { font-size: 11px; }
.sidebar-bottom span { font-size: 10px; color: #9ba8c0; margin-top: 4px; }
.status-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #36c997; display: inline-block; flex: 0 0 auto;
  box-shadow: 0 0 0 4px #36c99720;
}

.main-content { margin-left: 248px; padding: 34px 42px 22px; max-width: 1700px; }
.topbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 27px; }
.eyebrow, .section-kicker { color: #7774cb; }
.topbar h1 { font-size: clamp(23px, 3vw, 31px); letter-spacing: -1px; margin: 9px 0 6px; }
.topbar p, .panel-heading p { color: #7b8497; font-size: 13px; margin: 0; }
.top-status {
  white-space: nowrap; display: flex; align-items: center; gap: 10px;
  background: #fff; border: 1px solid #e8eaf0; border-radius: 30px;
  padding: 10px 15px; font-size: 11px; color: #536078;
}
.overview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 20px; }
.overview-card, .panel {
  background: #fff; border: 1px solid #e9ebf1; border-radius: 13px;
  box-shadow: 0 3px 12px #202c4308;
}
.overview-card { padding: 17px 20px; }
.metric-label { color: #8790a2; display: block; }
.overview-card strong { display: block; font-size: 20px; margin: 9px 0 4px; }
.overview-card small { color: #8992a3; font-size: 11px; }

.workspace-grid { display: grid; grid-template-columns: minmax(340px, .95fr) minmax(380px, 1.05fr); gap: 18px; align-items: start; }
.panel { padding: 23px; min-width: 0; }
.panel-heading { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 22px; }
.panel h2 { font-size: 17px; margin: 8px 0 6px; letter-spacing: -.3px; }
.scenario-area { margin-bottom: 19px; }
.scenario-area label, .form-field label { display: block; color: #788398; margin-bottom: 8px; }
.scenario-area select, .form-field input, .form-field select {
  width: 100%; height: 42px; border: 1px solid #e1e5ed; border-radius: 7px;
  padding: 0 11px; color: #26334b; background: #fff; outline: none;
}
.scenario-area select:focus, .form-field input:focus, .form-field select:focus {
  border-color: #7972e8; box-shadow: 0 0 0 3px #7972e817;
}
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 12px; }
.form-field { min-width: 0; }
.form-field label { font-size: 9px; }
.full-width { grid-column: 1 / -1; }
.primary-button, .secondary-button {
  border: 0; border-radius: 8px; padding: 13px 17px; font-size: 12px;
  font-weight: 700; transition: .15s ease;
}
.primary-button { width: 100%; margin-top: 22px; background: #625cdb; color: white; }
.primary-button:hover { background: #514bc4; }
.secondary-button { color: #554fd0; background: #f0efff; }
.secondary-button:hover { background: #e5e3ff; }
.form-note { font-size: 10px; line-height: 1.6; color: #929aaa; margin: 12px 0 0; }

.live-tag, .count-tag {
  font-size: 9px; font-weight: 750; letter-spacing: .5px; padding: 7px 9px;
  border-radius: 20px; white-space: nowrap;
}
.live-tag { color: #16845e; background: #e7f8f1; }
.count-tag { color: #615bd0; background: #f0efff; }
.empty-state { min-height: 335px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 20px; }
.empty-icon { width: 55px; height: 55px; border-radius: 16px; display: grid; place-items: center; background: #f0efff; color: #6861d9; font-size: 27px; }
.empty-state h3 { font-size: 14px; margin: 17px 0 7px; }
.empty-state p { color: #8b94a5; font-size: 11px; line-height: 1.7; max-width: 260px; }
.recommendation-card { border: 1px solid #e7e8f2; border-radius: 10px; padding: 18px; background: #f7f7ff; }
.recommendation-card h3 { font-size: 20px; margin: 9px 0 5px; color: #514bbd; }
.recommendation-card p { font-size: 11px; color: #7d8297; margin: 0; }
.recommendation-card.priority-outreach { background: #fff4f0; border-color: #f7ddd4; }
.recommendation-card.priority-outreach h3 { color: #c25435; }
.recommendation-card.tutor-review { background: #fff9e9; border-color: #f3e7bf; }
.recommendation-card.tutor-review h3 { color: #9b741b; }
.recommendation-card.request-more-info { background: #f1f6ff; border-color: #dbe7fa; }
.recommendation-card.request-more-info h3 { color: #3869a8; }
.score-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 0; border-bottom: 1px solid #edf0f4; }
.score-row strong { display: block; font-size: 26px; margin-top: 5px; }
.score-row strong small { font-size: 11px; color: #929aaa; font-weight: 500; }
.score-track { width: 42%; height: 8px; border-radius: 10px; background: #edf0f5; overflow: hidden; }
.score-fill { height: 100%; background: #6b65df; border-radius: inherit; }
.result-section { padding-top: 17px; }
.result-section h4, .agent-details h4 { font-size: 11px; margin: 0 0 10px; }
.reason-list { margin: 0; padding-left: 18px; color: #69748a; font-size: 11px; line-height: 1.8; }
.reason-list li { padding-left: 3px; margin-bottom: 4px; }
.tag-list { display: flex; flex-wrap: wrap; gap: 7px; }
.rule-tag { padding: 6px 8px; background: #f3f3fa; color: #5c5b91; border-radius: 5px; font-size: 9px; }
.muted { color: #969eac; font-size: 11px; }

.agents-panel { margin-top: 19px; }
.agent-list { border-top: 1px solid #edf0f4; }
.agent-item { border-bottom: 1px solid #edf0f4; }
.agent-item summary { display: flex; align-items: center; gap: 13px; padding: 15px 3px; cursor: pointer; list-style: none; }
.agent-item summary::-webkit-details-marker { display: none; }
.agent-number { color: #8c87dd; font-size: 11px; font-weight: 800; }
.agent-info { flex: 1; min-width: 0; }
.agent-info strong, .agent-info small { display: block; }
.agent-info strong { font-size: 11px; }
.agent-info small { color: #8b94a4; font-size: 10px; margin-top: 4px; }
.agent-flag { background: #f2f3f8; color: #69748a; padding: 5px 8px; border-radius: 5px; font-size: 9px; }
.expand-mark { color: #8b91a1; font-size: 17px; }
.agent-item[open] .expand-mark { transform: rotate(45deg); }
.agent-details { padding: 2px 15px 18px 38px; color: #6e788b; font-size: 11px; line-height: 1.7; }
.agent-details > p { margin-top: 0; }
.agent-meta { display: flex; gap: 20px; margin: 10px 0 14px; color: #8a93a3; }
.agent-meta strong { color: #414d63; }

.lower-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 19px; }
.explanation-text { font-size: 12px; line-height: 1.8; color: #68748a; }
.audit-reference { color: #6561c6; font-size: 10px; overflow-wrap: anywhere; margin: 14px 0; }
.audit-json { margin-top: 15px; padding: 13px; max-height: 300px; overflow: auto; background: #151d30; color: #d9e3f7; border-radius: 8px; font-size: 10px; line-height: 1.6; }
.error-banner { padding: 13px 16px; border: 1px solid #f3caca; background: #fff0f0; color: #a33b3b; border-radius: 8px; font-size: 12px; margin-top: 16px; }
.workflow-footer { display: flex; justify-content: space-between; gap: 12px; color: #929aaa; font-size: 10px; margin-top: 18px; }
.page-footer { text-align: center; color: #a0a7b4; font-size: 10px; padding: 28px 0 8px; }

@media (max-width: 1050px) {
  .sidebar { width: 205px; }
  .main-content { margin-left: 205px; padding: 28px 24px; }
  .workspace-grid { grid-template-columns: 1fr; }
}
@media (max-width: 700px) {
  .sidebar { position: static; width: 100%; height: auto; padding: 15px; }
  .brand { padding: 0 5px 15px; }
  .side-label, .nav-item, .sidebar-bottom { display: none; }
  .main-content { margin-left: 0; padding: 23px 14px; }
  .topbar { align-items: flex-start; flex-direction: column; }
  .overview-grid { grid-template-columns: 1fr; gap: 9px; }
  .overview-card { padding: 13px 16px; }
  .overview-card strong { font-size: 17px; }
  .lower-grid { grid-template-columns: 1fr; }
  .panel { padding: 17px; }
  .form-grid { grid-template-columns: 1fr; }
  .full-width { grid-column: auto; }
  .agent-item summary { gap: 8px; }
  .agent-info small { line-height: 1.4; }
  .agent-flag { max-width: 90px; overflow-wrap: anywhere; }
}
